              {
                "name": "api_key",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Follow a user"
        },
        {
          "info": {
            "name": "Unfollow a user",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://disqus.com/api/3.0/users/unfollow.json",
            "params": [
              {
                "name": "api_key",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Unfollow a user"
        }
      ]
    }
  ],
  "bundled": true
}